// Config overrides for stub test runs.
// Layered on top of the main nextflow.config via `-c` — disables container
// engines so stubs execute directly on the host, and silences reports.

docker.enabled    = false
singularity.enabled = false
apptainer.enabled = false

timeline.enabled = false
report.enabled   = false
trace.enabled    = false
dag.enabled      = false

process.executor = 'local'

// Keep process resource requests small enough to fit on CI runners
// (GitHub Actions ubuntu-latest has ~4 CPUs / 7 GB RAM). The `check_max`
// helper clamps every process request down to these values.
params {
    max_cpus   = 2
    max_memory = '4.GB'
    max_time   = '1.h'
}
