// Config overrides for stub test runs.
// Layered on top of the main nextflow.config via `-c` — disables container
// engines so stubs execute directly on the host, and silences reports.

docker.enabled    = false
singularity.enabled = false
apptainer.enabled = false

timeline.enabled = false
report.enabled   = false
trace.enabled    = false
dag.enabled      = false

process.executor = 'local'

// Clamp every process request down so the large labels (e.g. process_high_constant
// = 128 cpus) fit on small CI runners (GitHub Actions ubuntu-latest has ~4 CPUs /
// ~16 GB RAM). Set resourceLimits directly here — as a high-priority `-c` override
// it wins regardless of profile, so stub runs never depend on params.max_* timing.
process.resourceLimits = [ cpus: 2, memory: '4.GB', time: '1.h' ]
