/**
 * # Parameters for nf-maccoss-trex
 *
 * A NextFlow pipeline for analyzing data-ind
 */
params {
    /** \group{Input/Output Parameters} */

    /** \type{string} \required
     *  Location of a spectral file (.raw, .mzML, or .mzXML)
     */
    spectra_file = null

    /** \type{string} \required
     *  Location of the Casanovo params file
     */
    casanovo_params = 'casanovo.yaml'

    /** \type{string} \required
     *  Location of the Casanovo weights file
     */
    casanovo_weights = 'https://github.com/Noble-Lab/casanovo/releases/download/v5.0.0/casanovo_v5_0_0.ckpt'

    /** \type{boolean} \required
     *  Whether or not to use available GPUs. Set to false if no GPUs are available.
     */
    use_gpus = false

    /** \type{boolean} \required
     *  If true, CUDA_LAUNCH_BLOCKING=1 will be set to prevent errors on older GPUs. Do not use unless necessary, may degrade performance.
     */
    cuda_launch_blocking = false

    result_dir = 'results/nf-ms-dda-casanovo' /** \type{str} Where results will be saved. */
    report_dir = 'reports/nf-ms-dda-casanovo' /** \type{str} Where results will be saved. */
    email = null           /** \type{str} An email to alert on completion. */

    // Limelight params
    limelight_tags = null
    limelight_upload = false
    limelight_import_decoys = false
    limelight_entrapment_prefix = null

    // Default resource ceilings. Overridden per execution profile below. These
    // feed `process.resourceLimits` (see conf/base.config), which clamps every
    // task's request — the Nextflow 26-compatible replacement for check_max().
    max_cpus   = 8
    max_memory = '12.GB'
    max_time   = '240.h'
}

plugins {
    id 'nf-amazon'
}

docker {
    enabled = true
}

/*
 * Load secrets into the environment so they are available on AWS Batch, which
 * can't consume Nextflow secrets directly.
 *
 * These must be bare assignments: Nextflow 26's strict config parser rejects
 * `def` declarations and `if` statements in config files. `?.value` yields null
 * when a secret isn't set (e.g. stub tests), matching the previous guarded
 * behavior — the literal value is still baked into the task env for AWS Batch.
 */
env.LIMELIGHT_SUBMIT_UPLOAD_KEY = nextflow.secret.SecretsLoader.instance.load().getSecret("LIMELIGHT_SUBMIT_UPLOAD_KEY")?.value
env.PANORAMA_API_KEY = nextflow.secret.SecretsLoader.instance.load().getSecret("PANORAMA_API_KEY")?.value

aws {

    batch {
        // NOTE: this setting is only required if the AWS CLI tool is installed in a custom AMI
        cliPath = '/usr/local/aws-cli/v2/current/bin/aws'
        logsGroup = '/batch/tei-nextflow-batch'
        maxConnections = 20
        connectionTimeout = 10000
        uploadStorageClass = 'INTELLIGENT_TIERING'
        storageEncryption = 'AES256'
        retryMode = 'standard'
    }

    region = 'us-west-2'
}

// Execution Profiles
profiles {

    /*
     * Params for running pipeline on the local computer (e.g.:
     * your laptop). These can be overridden in the local config file.
     */
    standard {
        process.executor = 'local'

        // limit nextflow to running 1 task at a time
        executor.queueSize = 1

        params.max_memory = '12.GB'
        params.max_cpus = 8
        params.max_time = '240.h'

        // where to cache mzml files after running msconvert
        params.mzml_cache_directory = '/data/mass_spec/nextflow/nf-ms-dda-casanovo/mzml_cache'
        params.panorama_cache_directory = '/data/mass_spec/nextflow/panorama/raw_cache'
    }

    aws {
        process.executor = 'awsbatch'
        process.queue = 'nextflow_basic_ec2'

        // params for running pipeline on aws batch
        // These can be overridden in local config file

        // max params allowed for your AWS Batch compute environment
        params.max_memory = '124.GB'
        params.max_cpus = 32
        params.max_time = '240.h'

        // where to cache mzml files after running msconvert
        params.mzml_cache_directory = 's3://mc-tei-rex-nextflow-dda/mzml_cache'
        params.panorama_cache_directory = 's3://mc-tei-rex-nextflow-dda/panorama_cache'
    }

    slurm {
        process.executor = 'slurm'

        params.max_memory = '12.GB'
        params.max_cpus = 8
        params.max_time = '240.h'

        // where to cache mzml files after running msconvert
        params.mzml_cache_directory = '/data/mass_spec/nextflow/nf-ms-dda-casanovo/mzml_cache'
        params.panorama_cache_directory = '/data/mass_spec/nextflow/panorama/raw_cache'
    }

}

// Manifest
manifest {
    name            = 'nf-ms-dda-casanovo'
    author          = 'Michael Riffle'
    homePage        = 'https://github.com/mriffle/nf-ms-dda-casanovo'
    description     = 'De novo MS/MS searching workflow using Casanovo'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.04.0'
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Report files are timestamped so repeated runs don't clobber each other. The
// timestamp is inlined into each file name (rather than a shared top-level
// `def`) because Nextflow 26's strict config parser disallows variable
// declarations in config files; all four resolve within the same second.
timeline {
    enabled = true
    file    = "${params.report_dir}/execution_timeline_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}
report {
    enabled = true
    file    = "${params.report_dir}/execution_report_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}
trace {
    enabled = true
    file    = "${params.report_dir}/execution_trace_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.txt"
}
dag {
    enabled = false
    file    = "${params.report_dir}/pipeline_dag_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

// Load the images to use for all processes
includeConfig 'container_images.config'
